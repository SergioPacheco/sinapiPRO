	<queryString>
		<![CDATA[SELECT 
     sinapipro.composicao.codigo pai_id,
    sinapipro.composicao.codigo_composicao pai_codigo_composicao,
	sinapipro.composicao.descricao pai_descricao,
	sinapipro.composicao.unidade pai_unidade,
	sinapipro.composicao.custo_total pai_custo_total,
	sinapipro.composicao.custo_material pai_custo_material,
	sinapipro.composicao.custo_mao_obra pai_custo_mao_obra,
	sinapipro.composicao.custo_equipamento pai_custo_equipamento,
	sinapipro.composicao.perc_equipamento pai_perc_equipamento,
	sinapipro.composicao.perc_mao_obra pai_perc_mao_obra,
	sinapipro.composicao.perc_material pai_perc_material,
	 sinapipro.composicao_item.codigo filho_id,
	sinapipro.composicao_item.codigo_item filho_codigo_item,
	sinapipro.composicao_item.descricao filho_descricao,
	sinapipro.composicao_item.preco_unitario filho_preco,
	sinapipro.composicao_item.unidade filho_unidade,
	sinapipro.composicao_item.custo_total filho_custo_total,
	sinapipro.composicao_item.tipo filho_tipo,
	sinapipro.composicao_item.coeficiente filho_coeficiente,
	sinapipro.composicao_classe.sigla pai_sigla

FROM sinapipro.composicao_item

	INNER JOIN sinapipro.composicao ON  composicao.codigo = composicao_item.codigo_composicao_pai 
	INNER JOIN sinapipro.composicao_grupo ON composicao_grupo.codigo = composicao.codigo_composicao_grupo 
	INNER JOIN sinapipro.composicao_classe ON composicao_classe.codigo =  composicao_grupo.codigo_composicao_classe  
	INNER JOIN sinapipro.base_preco ON base_preco.codigo = composicao.codigo_base_preco 
	INNER JOIN sinapipro.base_insumo ON base_insumo.codigo = composicao.codigo_base_insumo
	
WHERE 
	 
   	composicao_item.codigo_composicao_pai =    $P{_Parameter9}]]>
	</queryString>
