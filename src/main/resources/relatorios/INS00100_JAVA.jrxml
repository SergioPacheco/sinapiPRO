	<queryString>
		<![CDATA[SELECT
    insumo.codigo, 
    insumo.codigo_insumo,
	insumo.descricao,
	insumo.unidade,
	insumo.especie,
    insumo.preco_padrao,
    bp.nome AS base_preco,
    bi.nome AS base_insumo
FROM
    insumo  
INNER JOIN base_insumo AS bi ON bi.codigo = insumo.codigo_base_insumo
INNER JOIN base_preco AS bp ON bp.codigo = insumo.codigo_base_preco 

WHERE
    $P!{_Parameter9}
	insumo.codigo_base_insumo = $P!{_Parameter10} 
	
	
ORDER BY  
	'$P!{_Parameter2}']]>
	</queryString>
