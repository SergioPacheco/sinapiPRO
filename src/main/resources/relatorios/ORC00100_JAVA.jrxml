	<queryString>
		<![CDATA[SELECT 
orca.codigo as orca_codigo,
orca.data_criacao as orca_data_criacao,
orca.nome as orca_nome,
orca.observacao as orca_observacao,
orca.valor_total as orca_total_orcamento,
orca.percentual_bdi as orca_perc_bdi,
orca.percentual_leis_sociais as orca_perc_leisoc,
orca.percentual_taxa_adm as orca_perc_taxadm,
orca.sub_total as orca_valor_subtotal,
orca.total_leis_sociais as orca_valor_leisoc,
orca.total_taxa_adm as orca_valor_taxadm,
orca.total_bdi as orca_valor_bdi,

obra.codigo as obra_codigo,
obra.cei as obra_cei,
obra.area as obra_area,
obra.cep as obra_cep,
obra.logradouro as obra_logradouro,
obra.complemento as obra_complemento,
obra.numero as obra_numero,
obra.nome as obra_nome,

cidade.nome as  cidade_nome,
estado.nome as estado_nome,
estado.sigla as estado_sigla,
bi.nome  as base_insumo_nome,
bp.nome as base_preco_nome, 

item.itemizacao as item_itemizacao, 
item.descricao as item_descricao,
item.tipo as item_tipo, 
item.especie as item_especie,
item.unidade as item_unidade,
item.quantidade as item_quantidade,
item.valor_unitario  as item_valor_unitario,
item.valor_unitario * item.quantidade as item_valor_total,

(orca.percentual_bdi * ( (item.valor_mao_obra * item.quantidade) + (item.valor_material * item.quantidade) + (item.valor_equipamento * item.quantidade) )) / 100  as item_valor_bdi, 
(orca.percentual_leis_sociais * (item.valor_mao_obra * item.quantidade)) / 100  as item_valor_leisoc,
(orca.percentual_taxa_adm * ((item.valor_mao_obra * item.quantidade)  + (item.valor_material * item.quantidade) + (item.valor_equipamento* item.quantidade))) / 100 as item_v_taxadm,

(orca.percentual_bdi * ( (item.valor_mao_obra *  item.quantidade) + (item.valor_material * item.quantidade) +  (item.valor_equipamento * item.quantidade) ) / 100)  +  
(orca.percentual_leis_sociais * (item.valor_mao_obra * item.quantidade)) / 100 + 
(orca.percentual_taxa_adm * ( (item.valor_mao_obra * item.quantidade) + (item.valor_material * item.quantidade)  +  (item.valor_equipamento * item.quantidade ) ) ) / 100 as item_valor_taxas,

(( item.valor_mao_obra * item.quantidade)  + (item.valor_material * item.quantidade) + (item.valor_equipamento * item.quantidade)) as item_valor_subtotal

FROM item 

INNER JOIN orcamento AS orca ON item.codigo_orcamento = orca.codigo
INNER JOIN obra  ON orca.codigo_obra  = obra.codigo 
INNER JOIN cidade ON obra.codigo_cidade = cidade.codigo
INNER JOIN estado ON cidade.codigo_estado = estado.codigo
INNER JOIN base_insumo AS bi ON orca.codigo_base_insumo = bi.codigo 
INNER JOIN base_preco AS bp ON orca.codigo_base_preco  = bp.codigo

WHERE
orca.codigo =  $P{_Parameter10}

ORDER BY 
item.itemizacao]]>
	</queryString>
