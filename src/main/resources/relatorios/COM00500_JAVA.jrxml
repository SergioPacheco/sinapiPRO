	<queryString>
		<![CDATA[SELECT
     item.tipo,
     item.descricao,
     item.quantidade, 
     item.unidade, 
     item.valor_unitario,
     item.valor_mao_obra,
     item.valor_material,
     item.valor_equipamento,
     orcamento.percentual_bdi,
     orcamento.percentual_taxa_adm,
     orcamento.percentual_leis_sociais,
     insumo.descricao as insumo_descricao,
     insumo.codigo_insumo,
     composicao.descricao as composicao_descricao,
     composicao.codigo_composicao as codigo_composicao, 
     ((orcamento.percentual_bdi * (item.valor_mao_obra + item.valor_material + item.valor_equipamento)) / 100)  as valor_bdi, 
     ((orcamento.percentual_leis_sociais * item.valor_mao_obra) / 100) as valor_leisoc,
     ((orcamento.percentual_taxa_adm * (item.valor_mao_obra + item.valor_material + item.valor_equipamento)) / 100) as valor_taxa_adm,
     (item.valor_mao_obra + item.valor_material + item.valor_equipamento) as subtotal
     
FROM
    sinapipro.item 
    
LEFT JOIN orcamento ON item.codigo_orcamento = orcamento.codigo 
LEFT JOIN composicao ON item.codigo_composicao = composicao.codigo
LEFT JOIN insumo ON item.codigo_insumo = insumo.codigo                             
    
WHERE
   item.codigo_orcamento = 3 AND item.tipo="COMPOSICAO"
	 
ORDER BY
	codigo_composicao]]>
	</queryString>
