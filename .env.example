# SinapiPRO — Environment Variables
# Copy to .env and adjust values for your environment

# Database
DB_URL=jdbc:postgresql://localhost:5432/sinapipro
DB_USERNAME=sinapipro
DB_PASSWORD=sinapipro

# Security (REQUIRED in production — min 48 chars)
JWT_SECRET=CHANGE-ME-in-production-use-a-random-48-char-string!!

# Elasticsearch (optional — app degrades gracefully without it)
SPRING_ELASTICSEARCH_URIS=http://localhost:9200

# Email (SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false

# Weather API (optional)
SINAPIPRO_WEATHER_API_KEY=

# Observability
OTEL_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SAMPLING=1.0

# Spring profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Demo user (dev only)
DEMO_USER=admin@sinapipro.dev
DEMO_PASSWORD=SinapiPro#2026
